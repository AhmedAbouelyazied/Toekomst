# SQLite database (relative to prisma/ folder)
DATABASE_URL="file:./dev.db"

# Base path when hosted under a subfolder (leave empty for local dev)
# NEXT_PUBLIC_BASE_PATH=/Toekomst_vzw

# Admin panel credentials (seeded into the database)
ADMIN_EMAIL="admin@toekomst.be"
ADMIN_PASSWORD="changeme"

# Session signing secret (any long random string)
AUTH_SECRET="change-this-to-a-long-random-string"

# Email notifications via Resend
RESEND_API_KEY=""
BOOKING_TO_EMAIL="info@toekomst.be"
BOOKING_FROM_EMAIL="VZW De Toekomst <no-reply@toekomst.be>"
